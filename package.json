{
  "name": "copilot-gateway",
  "displayName": "Copilot Gateway",
  "publisher": "local-copilot",
  "description": "Independent local Copilot gateway for Codex Responses, OpenAI clients, and Claude Desktop.",
  "icon": "images/icon.png",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/cruonline/copilot-proxy"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilot-gateway.exportCodexCatalog",
        "title": "Copilot Gateway: Export Codex Model Catalog"
      },
      {
        "command": "copilot-gateway.authorizeDirectResponses",
        "title": "Copilot Gateway: Authorize Native Codex Responses"
      },
      {
        "command": "copilot-gateway.start",
        "title": "Copilot Gateway: Start Server"
      },
      {
        "command": "copilot-gateway.stop",
        "title": "Copilot Gateway: Stop Server"
      },
      {
        "command": "copilot-gateway.status",
        "title": "Copilot Gateway: Show Status"
      },
      {
        "command": "copilot-gateway.setupClaudeGateway",
        "title": "Copilot Gateway: Configure Claude Desktop Gateway"
      },
      {
        "command": "copilot-gateway.restoreClaudeGateway",
        "title": "Copilot Gateway: Restore Claude Desktop Configuration"
      }
    ],
    "configuration": {
      "title": "Copilot Gateway",
      "properties": {
        "copilotGateway.responsesBackend": {
          "type": "string",
          "enum": [
            "vscode",
            "direct"
          ],
          "default": "vscode",
          "description": "Responses transport: public VS Code model adapter, or opt-in native Copilot forwarding for reasoning history and compaction. Native endpoint support depends on your Copilot model/account."
        },
        "copilotGateway.port": {
          "type": "number",
          "default": 8090,
          "description": "Port number for the proxy server"
        },
        "copilotGateway.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the server when VS Code launches"
        },
        "copilotGateway.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default model to use when not specified in request (leave empty to use first available)"
        },
        "copilotGateway.logRequestsToUI": {
          "type": "boolean",
          "default": false,
          "description": "Log all requests and responses to the status panel UI"
        },
        "copilotGateway.rawLogging": {
          "type": "boolean",
          "default": false,
          "description": "Log raw request/response content to the output channel (verbose)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "mocha --require ts-node/register \"src/test/**/*.test.ts\"",
    "test:coverage": "nyc npm run test",
    "test:codex": "npm run compile && node scripts/test-codex-compatibility.cjs",
    "docs:check": "node scripts/check-docs.js",
    "docs:inventory": "node scripts/update-inventory.js"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.x",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "chai": "^4.5.0",
    "eslint": "^8.56.0",
    "mocha": "^11.7.5",
    "sharp": "^0.34.5",
    "sinon": "^21.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "license": "MIT"
}
